---
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "PLV Studio", description = "个人作品展示与项目全生命周期记录站点" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Astro 内置客户端路由：导航时局部交换页面，消除整页重载的白屏/抖动；
         禁用 JS 时自动回退为普通多页跳转（渐进增强） -->
    <ClientRouter />
    <title>{title} · PLV Studio</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} · PLV Studio`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PLV Studio" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#F7F8FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <!-- 首帧前恢复主题，避免暗色模式闪烁（FOUC）；判定逻辑与 ThemeToggle 保持一致 -->
    <script is:inline>
      (function () {
        function applySavedTheme() {
          var saved = localStorage.getItem('theme');
          var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        }
        applySavedTheme();
        // ClientRouter 局部交换后 <html> 属性会被新页面覆盖，需在绘制前重新套用本地主题
        document.addEventListener('astro:after-swap', applySavedTheme);
      })();
    </script>
    <!-- Cloudflare Web Analytics：官方 beacon，仅生产构建注入（本地开发流量不计入统计） -->
    {import.meta.env.PROD && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "911b252005554d2fb5fbd52213277b5a"}'
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-background text-text-primary transition-colors duration-300 selection:bg-primary selection:text-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg"
    >
      跳转到主要内容
    </a>
    <SiteHeader />
    <main id="main" class="flex-grow">
      <slot />
    </main>
    <!-- 页脚使用固定定位语与版权文案，不随页面级 description 变化（SEO description 仍由 <head> 使用） -->
    <SiteFooter />
  </body>
</html>
