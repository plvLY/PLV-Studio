---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import TechStackTags from "../components/TechStackTags.astro";
import { getCollection } from "astro:content";
import { skillDirections } from "../data/skills";

const works = (await getCollection("works", ({ data }) => data.published)).map((e) => ({
  slug: e.id,
  ...e.data,
}));

const featuredWorks = works.filter((w) => w.featured && w.published);

// 编码模式流程（AI 编程 + 人力审核的真实工作流）
const codingSteps = ["AI 生成初稿", "人工审核", "构建与类型检查", "内容真实性核对"];

// 技术主线三卡：核心方向 / 前端模式 / 探索方向
const mainLines = [
  {
    label: "核心方向",
    title: "后端工程 · Java 系列",
    desc: "以 Java 系列为主的技术栈，专注于后端工程：服务端设计与实现，包括 API 设计与领域建模。",
  },
  {
    label: "前端模式",
    title: "AI 编程 + 人力审核",
    desc: "前端代码采用 AI 辅助生成、人工审核的编码模式。AI 负责效率，正确性、可维护性与内容真实性由人把关。",
  },
  {
    label: "探索方向",
    title: "AI 应用集成",
    desc: "目前持续探索 AI 应用集成：模型 API 接入、上游服务适配与集成方式，逐步接入实际项目。",
  },
];
---

<Layout
  title="关于"
  description="全栈开发工程师的技术主线：Java 后端专注、AI 编程+人力审核的前端模式与 AI 应用集成探索 - PLV Studio"
>
  <PageHeader
    title="关于"
    subtitle="全栈开发工程师 · Java 系列 · 专注后端工程 · 持续探索 AI 应用集成"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- 个人简介：围绕技术主线陈述 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">个人简介</h2>
      <p class="text-text-secondary leading-relaxed">
        全栈开发工程师，使用 Java 系列技术栈，专注于后端工程；前端采用 AI 编程 + 人力审核的编码模式，目前持续探索 AI 应用集成。通过 PLV Studio 以作品为中心，把每个项目的目标、设计文档、开发进度与阶段产物组织成可持续维护的内容体系。
      </p>
    </section>

    <!-- 技术主线：核心方向 / 前端模式 / 探索方向 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">技术主线</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {mainLines.map((line) => (
          <div class="p-6 rounded-xl border border-border bg-surface">
            <div class="text-xs font-semibold text-primary mb-2">{line.label}</div>
            <h3 class="font-semibold text-text-primary mb-2">{line.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{line.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 技术方向明细（与首页共用 skills.ts 数据） -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">主要技术方向</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {skillDirections.map((dir) => (
          <div class="p-5 rounded-xl border border-border bg-surface">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <h4 class="font-semibold text-text-primary">{dir.name}</h4>
              {dir.note && (
                <span class="px-2 py-0.5 text-xs rounded-full bg-primary/10 text-primary font-medium">
                  {dir.note}
                </span>
              )}
            </div>
            <ul class="text-sm text-text-secondary space-y-1">
              {dir.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="text-accent">▸</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 编码模式与工程实践：AI 编程 + 人力审核 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">编码模式与工程实践</h2>
      <div class="bg-surface rounded-xl border border-border p-6">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          {codingSteps.map((step, i) => (
            <div class="flex items-center gap-3">
              <span class="px-2 py-1 rounded bg-surface-muted border border-border text-text-primary">
                {step}
              </span>
              {i < codingSteps.length - 1 && <span class="text-text-secondary">→</span>}
            </div>
          ))}
        </div>
        <p class="text-text-secondary leading-relaxed mt-4">
          AI 负责编码效率，人工负责质量与事实把关：代码通过 astro check 与构建才算完成，内容不编造链接、日期与成果。内容以实际实现为准，规划中的技术方案明确标注为规划，而非已经落地的功能。
        </p>
      </div>
    </section>

    <!-- 代表作品与能力关联 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">代表作品与能力关联</h2>
      <div class="space-y-4">
        {featuredWorks.map((work) => (
          <div class="flex items-center gap-4 p-4 rounded-lg border border-border bg-surface">
            {work.icon ? (
              <img
                src={work.icon}
                alt=""
                class="w-12 h-12 rounded-lg object-cover shrink-0"
                width="48"
                height="48"
              />
            ) : (
              <div class="w-12 h-12 rounded-lg bg-surface-muted flex items-center justify-center text-text-secondary shrink-0">
                {work.title.charAt(0)}
              </div>
            )}
            <div class="flex-1">
              <h4 class="font-semibold text-text-primary">{work.title}</h4>
              <p class="text-sm text-text-secondary">{work.summary}</p>
              <TechStackTags tags={work.techStack} />
            </div>
            <a
              href={`/works/${work.slug}/`}
              class="text-sm text-primary hover:underline font-medium shrink-0"
            >
              查看详情 →
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- 持续探索方向 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-4">持续探索方向</h2>
      <ul class="list-disc list-inside text-text-secondary space-y-2">
        <li>深化 Java 系列后端工程：API 设计与领域建模</li>
        <li>探索 AI 应用集成：模型接入、上游服务适配与集成方式</li>
        <li>完善作品全生命周期记录与技术文档体系</li>
      </ul>
    </section>

    <!-- 外部博客入口 -->
    <section>
      <h2 class="text-xl font-bold text-text-primary mb-4">外部博客</h2>
      <a
        href="https://plv.netlify.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-primary hover:underline font-medium"
      >
        访问现有博客 ↗
      </a>
    </section>
  </div>
</Layout>
