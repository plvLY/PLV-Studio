---
import Layout from "../layouts/Layout.astro";
import FeaturedWorkCard from "../components/FeaturedWorkCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WorkCarousel from "../components/WorkCarousel.astro";
import CapabilityExplorer from "../components/CapabilityExplorer.astro";
import VisitorRouter from "../components/VisitorRouter.astro";
import ChangeList from "../components/ChangeList.astro";
import ReleaseBadge from "../components/ReleaseBadge.astro";
import { getCollection } from "astro:content";
import { progress } from "../data/progress";
import { skillDirections } from "../data/skills";
import { entryChanges, getRecentProgress } from "../lib/progress";
import { documentHref, latestDocumentByType } from "../lib/documents";
import { coverAlt, publicStatusLabel } from "../lib/works";

// works 集合（Content Collections）：entry.id 即 slug（文件名），映射为页面使用的扁平形状
const works = (await getCollection("works", ({ data }) => data.published)).map((e) => ({
  slug: e.id,
  ...e.data,
}));

const featuredWorks = works.filter((w) => w.featured);
// 首屏主案例优先选可在线访问的作品；没有时退回第一个精选/公开作品
const heroWork = featuredWorks.find((work) => work.demoUrl) ?? featuredWorks[0] ?? works[0];
const heroHref = heroWork ? `/works/${heroWork.slug}/` : "/works/";
const documentsHref = heroWork ? `${heroHref}documents/` : "/works/";
const progressHref = heroWork ? `${heroHref}#progress` : "/works/";
const otherFeatured = featuredWorks.filter((work) => work.slug !== heroWork?.slug);

// 站点统计只覆盖已发布作品及其文档；同一份数据同时驱动 Live Stats 与主作品卡
const docEntries = await getCollection("documents");
const publishedSlugs = new Set(works.map((work) => work.slug));
const publishedDocs = docEntries.filter((doc) => publishedSlugs.has(doc.id.split("/")[0]));
const docCount = publishedDocs.length;
const progressCount = works.reduce(
  (total, work) => total + (progress[work.slug]?.length ?? 0),
  0,
);
const heroDocCount = heroWork
  ? publishedDocs.filter((doc) => doc.id.startsWith(`${heroWork.slug}/`)).length
  : 0;
const heroProgressCount = heroWork ? (progress[heroWork.slug] ?? []).length : 0;

// 最近更新 = 已发布作品元数据与进度记录中的最新日期（不统计未发布内容）
const latestUpdate =
  [
    ...works.map((work) => work.updatedAt),
    ...works.flatMap((work) => (progress[work.slug] ?? []).map((entry) => entry.updatedAt)),
  ]
    .sort()
    .at(-1) ?? "";

const currentStatus = heroWork
  ? publicStatusLabel(heroWork.status, heroWork.demoUrl)
  : "暂无公开作品";
const heroIsLive = currentStatus === "已上线";

// 首屏数据胶囊：数字全部来自内容集合与进度数据，不做人工维护的假数据
const liveStats = [
  { label: "公开作品", value: String(works.length), unit: "个" },
  { label: "设计文档", value: String(docCount), unit: "份" },
  { label: "开发记录", value: String(progressCount), unit: "条" },
];

// 通用流程的「实例」：优先取对应类型的最新公开文档，其次取真实进度阶段
const docInstance = (type: string) => {
  const doc = latestDocumentByType(publishedDocs, type);
  if (!doc) return undefined;
  const [workSlug] = doc.id.split("/");
  const work = works.find((item) => item.slug === workSlug);
  return {
    href: documentHref(doc.id),
    label: `${work?.title ?? "作品"} · ${doc.data.title}`,
  };
};

const stageInstance = (keywords: string[]) => {
  for (const work of works) {
    const entry = (progress[work.slug] ?? []).find((item) =>
      keywords.some((keyword) => item.stage.includes(keyword)),
    );
    if (entry) {
      return { href: `/works/${work.slug}/#progress`, label: `${work.title} · ${entry.stage}` };
    }
  }
  return undefined;
};

// 技术同行入口：指向真正带架构图的站内页面（构建期从文档中提取并静态渲染）
const architectureDoc = publishedDocs.find(
  (doc) => doc.data.type === "architecture" && /```mermaid/.test(doc.body ?? ""),
);
const architectureSlug = architectureDoc?.id.split("/")[0];

const routes = [
  {
    icon: "recruiter" as const,
    eyebrow: "For Recruiters",
    title: "我是招聘方",
    description: `先看结果：${works.length} 个公开作品、${docCount} 份设计文档，以及每个项目真实的完成度与验收记录。`,
    meta: ["精选作品", "能力证据", "当前状态"],
    href: "#featured",
    action: "查看精选作品",
  },
  {
    icon: "engineer" as const,
    eyebrow: "For Engineers",
    title: "我是技术同行",
    description: "直接看架构、设计取舍与源码；文档里的架构图已静态渲染，不必下载代码再画一遍。",
    meta: ["架构图", "设计文档", "源码"],
    href: architectureSlug ? `/works/${architectureSlug}/#architecture` : "#capabilities",
    action: "看架构与文档",
  },
];

const recentProgress = getRecentProgress(progress, works, 3);

// 通用工作方法：每一步都给出一个站内真实实例，把「通用流程」落成「带实例的落地标准」
const workflow = [
  {
    title: "需求分析",
    description: "明确问题、目标、边界与可验证的验收标准。",
    example: docInstance("requirements"),
  },
  {
    title: "产品设计",
    description: "组织信息结构、交互路径与视觉层级。",
    example: docInstance("ui"),
  },
  {
    title: "技术架构",
    description: "选择技术方案，划分边界并记录关键取舍。",
    example: docInstance("architecture"),
  },
  {
    title: "开发实现",
    description: "小步实现，持续做类型检查与构建校验。",
    example: stageInstance(["开发实现"]),
  },
  {
    title: "测试验收",
    description: "核对响应式、可访问性、链接与静态资源。",
    example: stageInstance(["测试验收"]),
  },
  {
    title: "发布迭代",
    description: "部署上线，根据真实使用情况维护与迭代。",
    example: stageInstance(["发布部署", "发布迭代"]),
  },
];

const description =
  "PLV Studio 个人作品与技术实践站点：记录真实项目从需求分析、产品设计、技术架构到开发验收的过程，以及可追溯的文档与技术产物。";
---

<Layout title="首页" description={description}>
  <!-- 首屏：品牌定位 + Live Stats + 真实项目预览，作品入口优先 -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <div class="absolute -right-20 -top-24 h-[26rem] w-[26rem] rounded-full bg-primary/10 blur-3xl dark:bg-accent/10"></div>
      <div class="absolute -left-24 bottom-0 h-64 w-64 rounded-full bg-accent/10 blur-3xl dark:bg-primary/10"></div>
    </div>

    <div class="container-page relative z-10 grid gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] lg:items-center lg:gap-14 lg:py-20">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <div class="rounded-lg border border-border bg-white px-3 py-2 shadow-xs dark:border-white/10">
            <img src="/plv.png" alt="" class="h-8 w-auto" width="363" height="139" />
          </div>
          <div>
            <p class="text-sm font-semibold text-text-primary">PLV Studio</p>
            <p class="text-xs text-text-muted">个人作品与技术实践</p>
          </div>
        </div>

        <p class="eyebrow mt-7">真实项目 · 全过程记录</p>
        <h1 class="mt-3 text-[2.15rem] font-bold leading-[1.16] tracking-tight text-text-primary sm:text-5xl lg:text-[3.4rem]">
          把想法做成产品，<br />把过程沉淀为资产。
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
          PLV Studio 记录真实项目从需求分析、产品设计、技术架构到开发验收的全过程，以及每个阶段可追溯的文档与技术产物。
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={heroHref} class="btn btn-primary">
            查看精选作品
            <span aria-hidden="true">→</span>
          </a>
          <a href={documentsHref} class="btn btn-secondary">浏览设计文档</a>
          <a
            href="/about/"
            class="inline-flex min-h-11 items-center gap-1 px-1 text-sm font-medium text-text-secondary transition-colors hover:text-primary dark:hover:text-accent"
          >
            了解工作方式
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Live Stats：大号数字 + 状态，让「持续运营的活跃项目」一眼可见 -->
        <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface/85 shadow-sm backdrop-blur-sm">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-border/70 px-4 py-2.5 sm:px-5">
            <span class="inline-flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-text-muted">
              <span class="live-dot" aria-hidden="true"></span>
              Live Stats
            </span>
            <span class="text-[11px] text-text-muted">
              最近更新 <time datetime={latestUpdate} class="tabular-nums">{latestUpdate || "—"}</time>
            </span>
          </div>
          <dl class="grid grid-cols-2 gap-px bg-border/60 sm:grid-cols-4">
            {liveStats.map((stat) => (
              <div class="bg-surface/95 px-4 py-3.5 sm:px-5">
                <dt class="text-[11px] text-text-muted">{stat.label}</dt>
                <dd class="mt-1 flex items-baseline gap-1">
                  <span class="text-2xl font-bold tabular-nums tracking-tight text-text-primary">{stat.value}</span>
                  <span class="text-xs text-text-muted">{stat.unit}</span>
                </dd>
              </div>
            ))}
            <div class="bg-surface/95 px-4 py-3.5 sm:px-5">
              <dt class="text-[11px] text-text-muted">核心项目</dt>
              <dd class="mt-1.5 flex items-center gap-1.5 text-sm font-semibold text-text-primary">
                <span
                  class:list={["h-1.5 w-1.5 shrink-0 rounded-full", heroIsLive ? "bg-success" : "bg-warning"]}
                  aria-hidden="true"
                ></span>
                <span class="truncate">{currentStatus}</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- 真实运行截图：终端风格框体 + 悬停微缩放大，不使用装饰图 -->
      {heroWork && (
        <figure class="min-w-0 lg:pl-2">
          <a
            href={heroHref}
            class="hero-window group block"
            aria-label={`查看 ${heroWork.title} 项目详情`}
          >
            <div class="hero-window-bar">
              <span class="flex shrink-0 gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
              </span>
              <span class="mx-auto hidden min-w-0 truncate font-mono text-[11px] text-white/45 sm:block">
                {Astro.site?.host ?? "plvstudio.netlify.app"}{heroHref}
              </span>
              <span class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-medium text-white/70 sm:ml-0">
                <span
                  class:list={["h-1.5 w-1.5 rounded-full", heroIsLive ? "bg-emerald-400" : "bg-amber-400"]}
                  aria-hidden="true"
                ></span>
                {currentStatus}
              </span>
            </div>
            <div class="hero-window-body">
              <img
                src={heroWork.cover}
                alt={coverAlt(heroWork.title, heroWork.coverKind)}
                width="1440"
                height="810"
                class="hero-window-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="hero-window-sheen" aria-hidden="true"></span>
            </div>
          </a>
          <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-text-secondary">
            <span>{heroWork.title} · {heroWork.coverKind === "screenshot" ? "真实运行截图" : "项目封面"}</span>
            <span class="inline-flex items-center gap-1 font-medium text-text-muted">
              点击查看项目详情
              <span aria-hidden="true">→</span>
            </span>
          </figcaption>
        </figure>
      )}
    </div>
  </section>

  <VisitorRouter routes={routes} />

  <!-- 精选作品：主案例 + 其他精选作品的横向滑动带 -->
  <section id="featured" class="section-shell">
    <div class="container-page">
      <SectionHeading
        eyebrow="Selected Work"
        title="精选作品"
        description="以一个完整案例呈现从需求、设计文档到上线验收的真实建设过程；其余精选作品在下方继续展开。"
        actionHref="/works/"
        actionLabel="查看全部作品"
      />

      <div class="mt-8">
        {heroWork ? (
          <FeaturedWorkCard
            work={heroWork}
            docCount={heroDocCount}
            progressCount={heroProgressCount}
          />
        ) : (
          <p class="rounded-xl border border-dashed border-border px-6 py-14 text-center text-sm text-text-secondary">
            暂无公开作品，作品发布后会在这里展示真实案例。
          </p>
        )}
      </div>

      {otherFeatured.length > 0 && (
        <div class="mt-10">
          <div>
            <h3 class="text-lg font-semibold text-text-primary">更多精选作品</h3>
            <p class="mt-1 text-sm text-text-secondary">同样公开了设计文档与开发记录，仍在持续建设。</p>
          </div>
          <WorkCarousel works={otherFeatured} />
        </div>
      )}
    </div>
  </section>

  <!-- 能力与证据：标签页先展开站内实现脉络，再给出外部仓库出口 -->
  <section id="capabilities" class="border-y border-border bg-surface-muted/70">
    <div class="container-page section-shell">
      <SectionHeading
        eyebrow="Capabilities"
        title="能力与证据"
        description="能力通过真实项目、文档与代码证明。点开任一方向，先在站内看实现脉络，再决定要不要去外部仓库。「探索中」的方向不会被标成已完成。"
      />

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs text-text-secondary">
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>已实践 · 有站内产物</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-warning" aria-hidden="true"></span>探索中 · 外部持续迭代</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-accent" aria-hidden="true"></span>专业方向 · 公开案例有限</span>
      </div>

      <CapabilityExplorer skills={skillDirections} />
    </div>
  </section>

  <!-- 最近开发记录：发布日志式摘要，完整记录在项目详情页 -->
  <section id="recent" class="section-shell">
    <div class="container-page">
      <SectionHeading
        eyebrow="Release Notes"
        title="最近更新"
        description="按真实更新日期列出最近阶段，变更按新功能 / 修复 / 性能 / 文档分类；完整发布记录保留在项目详情页。"
        actionHref={progressHref}
        actionLabel="查看完整发布记录"
      />

      {recentProgress.length > 0 ? (
        <ol class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface">
          {recentProgress.map((entry) => (
            <li class="grid gap-3 p-5 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-6 sm:p-6 [&+&]:border-t [&+&]:border-border">
              <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-start">
                <time datetime={entry.updatedAt} class="text-sm font-semibold tabular-nums text-text-primary">
                  {entry.updatedAt}
                </time>
                <ReleaseBadge status={entry.status} />
              </div>

              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-semibold text-text-primary">{entry.stage}</h3>
                  <a
                    href={`/works/${entry.workSlug}/#progress`}
                    class="text-xs font-medium text-primary underline-offset-4 hover:underline dark:text-accent"
                  >
                    {entry.workTitle}
                  </a>
                </div>

                <ChangeList changes={entryChanges(entry)} variant="compact" limit={3} class="mt-2" />

                {entry.nextSteps.length > 0 && (
                  <p class="mt-2 text-xs leading-relaxed text-text-secondary">
                    <span class="font-medium text-text-primary">下一步：</span>
                    {entry.nextSteps.join("；")}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-14 text-center text-sm text-text-secondary">
          暂无开发记录
        </p>
      )}
    </div>
  </section>

  <!-- 开发理念：通用六阶段工作方法，每一步都链接到站内真实实例 -->
  <section id="process" class="border-t border-border bg-surface-muted/70">
    <div class="container-page section-shell">
      <SectionHeading
        eyebrow="How I Work"
        title="通用开发流程"
        description="需求分析、产品设计、技术架构、开发实现、测试验收、发布迭代。每个阶段都指向站内真实文档或记录，而不是只列概念。"
      />

      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {workflow.map((step, index) => (
          <li class="flex flex-col rounded-xl border border-border bg-surface p-5">
            <div class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold tabular-nums text-primary dark:bg-accent/10 dark:text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <h3 class="font-semibold text-text-primary">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-text-secondary">{step.description}</p>
              </div>
            </div>

            {step.example && (
              <a
                href={step.example.href}
                class="mt-4 flex min-h-9 items-center gap-1.5 border-t border-border/70 pt-3 text-xs text-text-secondary transition-colors hover:text-primary dark:hover:text-accent"
              >
                <span class="shrink-0 text-text-muted">实例</span>
                <span class="truncate font-medium">{step.example.label}</span>
                <span class="ml-auto shrink-0" aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))}
      </ol>

      <p class="mt-6 text-xs leading-relaxed text-text-muted">
        具体项目的实际进度、验收事项与下一步，以作品详情中的「开发与发布记录」为准；通用流程不代表任何单一项目的当前状态。
      </p>
    </div>
  </section>
</Layout>
