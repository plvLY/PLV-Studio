---
import Layout from "../layouts/Layout.astro";
import FeaturedWorkCard from "../components/FeaturedWorkCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SkillCard from "../components/SkillCard.astro";
import WorkStatusBadge from "../components/WorkStatusBadge.astro";
import { getCollection } from "astro:content";
import { progress } from "../data/progress";
import { skillDirections } from "../data/skills";
import { getRecentProgress } from "../lib/progress";
import { publicStatusLabel } from "../lib/works";

// works 集合（Content Collections）：entry.id 即 slug（文件名），映射为页面使用的扁平形状
const works = (await getCollection("works", ({ data }) => data.published)).map((e) => ({
  slug: e.id,
  ...e.data,
}));

const featuredWorks = works.filter((w) => w.featured && w.published);
// 只有一个公开作品时也保证首页有主案例；没有作品时相关入口回退到作品列表
const featuredWork = featuredWorks[0] ?? works[0];
const featuredHref = featuredWork ? `/works/${featuredWork.slug}/` : "/works/";
const documentsHref = featuredWork ? `${featuredHref}documents/` : "/works/";
const progressHref = featuredWork ? `${featuredHref}#progress` : "/works/";

// 站点速览只统计已发布作品及其文档；同一份数据同时驱动主作品卡
const docEntries = await getCollection("documents");
const publishedSlugs = new Set(works.map((work) => work.slug));
const publishedDocs = docEntries.filter((doc) => publishedSlugs.has(doc.id.split("/")[0]));
const docCount = publishedDocs.length;
const featuredDocCount = featuredWork
  ? publishedDocs.filter((doc) => doc.id.startsWith(`${featuredWork.slug}/`)).length
  : 0;
const featuredProgress = featuredWork ? (progress[featuredWork.slug] ?? []) : [];

// 最近更新 = 已发布作品元数据与进度记录中的最新日期（不统计未发布内容）
const latestUpdate =
  [
    ...works.map((work) => work.updatedAt),
    ...works.flatMap((work) => (progress[work.slug] ?? []).map((entry) => entry.updatedAt)),
  ]
    .sort()
    .at(-1) ?? "";

const currentStatus = featuredWork
  ? publicStatusLabel(featuredWork.status, featuredWork.demoUrl)
  : "暂无公开作品";

const recentProgress = getRecentProgress(progress, works, 3);

// 通用工作方法：只表达「通常如何推进」，不绑定任何项目的当前进度
const workflow = [
  { title: "需求分析", description: "明确问题、目标、边界与可验证的验收标准。" },
  { title: "产品设计", description: "组织信息结构、交互路径与视觉层级。" },
  { title: "技术架构", description: "选择技术方案，划分边界并记录关键取舍。" },
  { title: "开发实现", description: "小步实现，持续做类型检查与构建校验。" },
  { title: "测试验收", description: "核对响应式、可访问性、链接与静态资源。" },
  { title: "发布迭代", description: "部署上线，根据真实使用情况维护与迭代。" },
];

const description =
  "PLV Studio 个人作品与技术实践站点：记录真实项目从需求分析、产品设计、技术架构到开发验收的过程，以及可追溯的文档与技术产物。";
---

<Layout title="首页" description={description}>
  <!-- 首屏：品牌定位 + 真实项目预览，作品入口优先 -->
  <section class="relative overflow-hidden">
    <div class="container-page grid gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] lg:items-center lg:gap-14 lg:py-20">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <div class="rounded-lg border border-border bg-white px-3 py-2 shadow-xs">
            <img
              src="/plv.png"
              alt=""
              class="h-8 w-auto"
              width="363"
              height="139"
            />
          </div>
          <div>
            <p class="text-sm font-semibold text-text-primary">PLV Studio</p>
            <p class="text-xs text-text-muted">个人作品与技术实践</p>
          </div>
        </div>

        <p class="eyebrow mt-8">真实项目 · 全过程记录</p>
        <h1 class="mt-3 text-[2.15rem] font-bold leading-[1.16] tracking-tight text-text-primary sm:text-5xl lg:text-[3.4rem]">
          把想法做成产品，<br />把过程沉淀为资产。
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
          PLV Studio 记录真实项目从需求分析、产品设计、技术架构到开发验收的全过程，以及每个阶段可追溯的文档与技术产物。
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={featuredHref} class="btn btn-primary">
            查看精选作品
            <span aria-hidden="true">→</span>
          </a>
          <a href={documentsHref} class="btn btn-secondary">浏览设计文档</a>
          <a
            href="/about/"
            class="inline-flex min-h-11 items-center gap-1 px-1 text-sm font-medium text-text-secondary transition-colors hover:text-primary dark:hover:text-accent"
          >
            了解工作方式
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
          <span>公开作品 <strong class="font-semibold text-text-primary tabular-nums">{works.length}</strong> 个</span>
          <span aria-hidden="true">·</span>
          <span>设计文档 <strong class="font-semibold text-text-primary tabular-nums">{docCount}</strong> 份</span>
          <span aria-hidden="true">·</span>
          <span>最近更新 <time datetime={latestUpdate}>{latestUpdate || "—"}</time></span>
        </p>
      </div>

      <!-- 真实详情页截图：展示「文档 + 进度」这一核心产物，不使用装饰图 -->
      {featuredWork && (
        <figure class="min-w-0 lg:pl-2">
          <a
            href={featuredHref}
            class="group block rounded-2xl border border-border bg-surface p-2 shadow-sm transition-colors hover:border-primary/35 sm:p-2.5"
            aria-label={`查看 ${featuredWork.title} 项目详情`}
          >
            <div class="overflow-hidden rounded-xl border border-border bg-surface-muted">
              <img
                src={`/images/works/${featuredWork.slug}/detail.svg`}
                alt={`${featuredWork.title} 项目详情页运行截图`}
                width="1440"
                height="1800"
                class="aspect-[4/3] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.01] motion-reduce:transform-none"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </a>
          <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-text-secondary">
            <span>{featuredWork.title} · 项目详情 / 文档系统</span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2.5 py-1 font-medium text-text-primary">
              <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
              {currentStatus}
            </span>
          </figcaption>
        </figure>
      )}
    </div>
  </section>

  <!-- 站点速览：低权重数据带，口径来自已发布内容，不再混用「阶段数」与「流程步骤数」 -->
  <section aria-labelledby="snapshot-title" class="border-y border-border bg-surface">
    <div class="container-page">
      <div class="grid gap-5 py-6 md:grid-cols-[10rem_minmax(0,1fr)] md:items-center md:py-7">
        <div>
          <h2 id="snapshot-title" class="text-sm font-semibold text-text-primary">站点速览</h2>
          <p class="mt-1 text-xs text-text-muted">来自已发布内容</p>
        </div>
        <dl class="grid grid-cols-2 gap-x-5 gap-y-5 sm:grid-cols-4 sm:gap-x-8">
          <div class="border-l border-border pl-4">
            <dt class="text-xs text-text-muted">公开作品</dt>
            <dd class="mt-1 text-lg font-semibold tabular-nums text-text-primary">{works.length} 个</dd>
          </div>
          <div class="border-l border-border pl-4">
            <dt class="text-xs text-text-muted">设计文档</dt>
            <dd class="mt-1 text-lg font-semibold tabular-nums text-text-primary">{docCount} 份</dd>
          </div>
          <div class="border-l border-border pl-4">
            <dt class="text-xs text-text-muted">精选作品状态</dt>
            <dd class="mt-1 flex items-center gap-1.5 text-base font-semibold text-text-primary">
              <span class:list={["h-1.5 w-1.5 rounded-full", currentStatus === "已上线" ? "bg-success" : "bg-text-muted"]} aria-hidden="true"></span>
              {currentStatus}
            </dd>
          </div>
          <div class="border-l border-border pl-4">
            <dt class="text-xs text-text-muted">最近更新</dt>
            <dd class="mt-1 text-base font-semibold tabular-nums text-text-primary">
              <time datetime={latestUpdate}>{latestUpdate || "—"}</time>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 精选作品：唯一公开作品用一张完整案例卡承载，不复制卡片填充网格 -->
  <section id="featured" class="section-shell">
    <div class="container-page">
      <SectionHeading
        eyebrow="Selected Work"
        title="精选作品"
        description="以一个完整案例，呈现从需求分析、设计文档到上线验收的真实建设过程。"
        actionHref="/works/"
        actionLabel="查看全部作品"
      />

      <div class="mt-8">
        {featuredWork ? (
          <FeaturedWorkCard
            work={featuredWork}
            docCount={featuredDocCount}
            progressCount={featuredProgress.length}
          />
        ) : (
          <p class="rounded-xl border border-dashed border-border px-6 py-14 text-center text-sm text-text-secondary">
            暂无公开作品，作品发布后会在这里展示真实案例。
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- 能力与证据：每项能力关联站内文档、作品或已核验的外部仓库 -->
  <section id="capabilities" class="border-y border-border bg-surface-muted/70">
    <div class="container-page section-shell">
      <SectionHeading
        eyebrow="Capabilities"
        title="能力与证据"
        description="能力通过真实项目、文档与代码证明。「探索中」的方向不会被标成已完成。"
      />

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs text-text-secondary">
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>已实践 · 有站内产物</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-warning" aria-hidden="true"></span>探索中 · 外部持续迭代</span>
        <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-accent" aria-hidden="true"></span>专业方向 · 公开案例有限</span>
      </div>

      <div class="mt-7 grid gap-5 md:grid-cols-2">
        {skillDirections.map((skill) => (
          <SkillCard skill={skill} />
        ))}
      </div>
    </div>
  </section>

  <!-- 最近开发记录：按真实日期展示最近 3 条，完整记录在项目详情页 -->
  <section id="recent" class="section-shell">
    <div class="container-page">
      <SectionHeading
        eyebrow="Changelog"
        title="最近开发记录"
        description="按真实更新日期列出最近完成的阶段事项；完整时间线保留在项目详情页。"
        actionHref={progressHref}
        actionLabel="查看完整记录"
      />

      {recentProgress.length > 0 ? (
        <ol class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface">
          {recentProgress.map((entry) => (
            <li class="grid gap-3 p-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6 sm:p-6 [&+&]:border-t [&+&]:border-border">
              <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-start">
                <time datetime={entry.updatedAt} class="text-sm font-semibold tabular-nums text-text-primary">
                  {entry.updatedAt}
                </time>
                <WorkStatusBadge status={entry.status} />
              </div>

              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-semibold text-text-primary">{entry.stage}</h3>
                  <a
                    href={`/works/${entry.workSlug}/#progress`}
                    class="text-xs font-medium text-primary underline-offset-4 hover:underline dark:text-accent"
                  >
                    {entry.workTitle}
                  </a>
                </div>

                {entry.completedItems.length > 0 && (
                  <ul class="mt-2.5 space-y-1.5 text-sm text-text-secondary">
                    {entry.completedItems.slice(0, 2).map((item) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-border" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                  {entry.completedItems.length > 2 && (
                    <span class="text-text-muted">另有 {entry.completedItems.length - 2} 项完成事项</span>
                  )}
                  {entry.nextSteps.length > 0 && (
                    <span class="text-text-secondary">
                      <span class="font-medium text-text-primary">下一步：</span>
                      {entry.nextSteps.join("；")}
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-14 text-center text-sm text-text-secondary">
          暂无开发记录
        </p>
      )}
    </div>
  </section>

  <!-- 开发理念：通用六阶段工作方法，明确不代表当前项目状态 -->
  <section id="process" class="border-t border-border bg-surface-muted/70">
    <div class="container-page section-shell">
      <SectionHeading
        eyebrow="How I Work"
        title="通用开发流程"
        description="需求分析、产品设计、技术架构、开发实现、测试验收、发布迭代。这是一套工作方法，不代表任何单一项目的当前状态。"
      />

      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {workflow.map((step, index) => (
          <li class="flex gap-4 rounded-xl border border-border bg-surface p-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold tabular-nums text-primary dark:bg-accent/10 dark:text-accent">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="min-w-0">
              <h3 class="font-semibold text-text-primary">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-text-secondary">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-6 text-xs leading-relaxed text-text-muted">
        具体项目的实际进度、验收事项与下一步，以作品详情中的「开发进度」记录为准。
      </p>
    </div>
  </section>
</Layout>
