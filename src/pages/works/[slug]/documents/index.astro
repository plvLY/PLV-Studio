---
import Layout from "../../../../layouts/Layout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import DocumentCard from "../../../../components/DocumentCard.astro";
import { getCollection } from "astro:content";
import { sortByLifecycle, docTypeLabel } from "../../../../lib/documents";
import { publicStatusLabel } from "../../../../lib/works";

export async function getStaticPaths() {
  // 父目录唯一 slug：entry.id 形如 plv-studio/requirements
  const [entries, works] = await Promise.all([
    getCollection("documents"),
    getCollection("works", ({ data }) => data.published),
  ]);
  // 只为已发布作品生成文档列表路由，避免草稿文档绕过发布门禁
  const publishedSlugs = new Set(works.map((work) => work.id));
  const slugs = [
    ...new Set(
      entries
        .filter((entry) => publishedSlugs.has(entry.id.split("/")[0]!))
        .map((entry) => entry.id.split("/")[0]!),
    ),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as string;
const workEntries = await getCollection("works");
const workEntry = workEntries.find((w) => w.id === slug);

if (!workEntry) {
  throw new Error(`作品不存在：${slug}`);
}

const work = { slug, ...workEntry.data };

const docEntries = await getCollection("documents", ({ id }) => id.startsWith(`${slug}/`));
const workDocs = sortByLifecycle(docEntries.map((d) => ({ docId: d.id.split("/")[1], ...d.data })));
const latestDocUpdate = workDocs.map((doc) => doc.updatedAt).sort().at(-1) ?? work.updatedAt;
const docTypes = [...new Set(workDocs.map((doc) => docTypeLabel(doc.type)))];

const workHref = `/works/${slug}/`;
const pageDescription = `${work.title}的公开设计文档：${workDocs.map((doc) => doc.title).join("、") || "暂无文档"}。按需求、架构、设计等开发节点排序。`;
---

<Layout title="设计文档" description={pageDescription} image={work.cover || undefined}>
  <div class="container-page pt-6 sm:pt-8">
    <Breadcrumbs
      items={[
        { label: "首页", href: "/" },
        { label: "作品", href: "/works/" },
        { label: work.title, href: workHref },
        { label: "设计文档" },
      ]}
    />
  </div>

  <PageHeader
    eyebrow={`作品文档 · ${work.title}`}
    title="设计文档"
    subtitle={`查看 ${work.title} 从需求到设计取舍的公开文档。文档按开发节点排序，版本与更新日期来自文件元数据。`}
  >
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <a href={workHref} class="btn btn-secondary">← 返回作品详情</a>
      <a href={`${workHref}#progress`} class="btn btn-ghost">查看开发记录</a>
    </div>
  </PageHeader>

  <div class="container-page pb-16">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-4">
      <div class="bg-surface px-4 py-4">
        <dt class="text-xs text-text-muted">公开文档</dt>
        <dd class="mt-1 text-lg font-semibold tabular-nums text-text-primary">{workDocs.length} 份</dd>
      </div>
      <div class="bg-surface px-4 py-4">
        <dt class="text-xs text-text-muted">覆盖类型</dt>
        <dd class="mt-1 text-sm font-semibold text-text-primary">{docTypes.length > 0 ? docTypes.join("、") : "暂无"}</dd>
      </div>
      <div class="bg-surface px-4 py-4">
        <dt class="text-xs text-text-muted">最近更新</dt>
        <dd class="mt-1 text-sm font-semibold tabular-nums text-text-primary">
          <time datetime={latestDocUpdate}>{latestDocUpdate}</time>
        </dd>
      </div>
      <div class="bg-surface px-4 py-4">
        <dt class="text-xs text-text-muted">所属作品状态</dt>
        <dd class="mt-1 text-sm font-semibold text-text-primary">{publicStatusLabel(work.status, work.demoUrl)}</dd>
      </div>
    </dl>

    <section class="mt-10" aria-labelledby="document-list-title">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-border pb-3">
        <h2 id="document-list-title" class="text-xl font-bold text-text-primary">全部文档</h2>
        <p class="text-xs text-text-muted">按开发节点排序 · 共 {workDocs.length} 份</p>
      </div>

      {workDocs.length > 0 ? (
        <ol class="mt-2 max-w-4xl">
          {workDocs.map((doc, index) => (
            <li class="flex items-start gap-3 border-b border-border/70 last:border-b-0 sm:gap-5">
              <span class="mt-5 w-7 shrink-0 text-xs font-semibold tabular-nums text-text-muted" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0 flex-1">
                <DocumentCard doc={doc} docId={doc.docId} workSlug={slug} variant="row" />
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="mt-6 rounded-xl border border-dashed border-border px-6 py-16 text-center text-sm text-text-secondary">
          暂无公开设计文档
        </div>
      )}
    </section>

    <section class="mt-10 max-w-4xl rounded-xl border border-border bg-surface-muted/60 p-5 sm:p-6" aria-labelledby="docs-note-title">
      <h2 id="docs-note-title" class="text-base font-semibold text-text-primary">文档说明</h2>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        当前公开文档覆盖：{docTypes.length > 0 ? docTypes.join("、") : "暂无"}。测试验收、发布记录与维护说明记录在作品的
        <a href={`${workHref}#progress`} class="text-link">开发与发布记录</a>
        与
        <a href={`${workHref}#release`} class="text-link">验收与上线</a>
        章节中；复盘文档尚未单独发布，不以空文档占位。
      </p>
    </section>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={workHref} class="btn btn-secondary">← 返回 {work.title}</a>
      <a href="/works/" class="text-link">全部作品</a>
    </div>
  </div>
</Layout>
