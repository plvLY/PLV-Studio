---
import Layout from "../../../../layouts/Layout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import DocumentCard from "../../../../components/DocumentCard.astro";
import { getCollection } from "astro:content";
import { sortByLifecycle } from "../../../../lib/documents";

export async function getStaticPaths() {
  // 父目录唯一 slug：entry.id 形如 plv-studio/requirements
  const entries = await getCollection("documents");
  const slugs = [...new Set(entries.map((e) => e.id.split("/")[0]))];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as string;
const workEntries = await getCollection("works");
const workEntry = workEntries.find((w) => w.id === slug);

if (!workEntry) {
  throw new Error(`作品不存在：${slug}`);
}

const work = { slug, ...workEntry.data };

const docEntries = await getCollection("documents", ({ id }) => id.startsWith(`${slug}/`));
const workDocs = sortByLifecycle(docEntries.map((d) => ({ docId: d.id.split("/")[1], ...d.data })));
---

<Layout title={`${work.title} - 设计文档`} description={`${work.title} 的设计文档列表`}>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-6" aria-label="面包屑导航">
    <ol class="breadcrumbs flex flex-wrap items-center gap-2 text-sm text-text-secondary">
      <li><a href="/" class="hover:text-primary transition-colors">首页</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/works/" class="hover:text-primary transition-colors">作品</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/works/${slug}/`} class="hover:text-primary transition-colors">{work.title}</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-text-primary" aria-current="page">设计文档</li>
    </ol>
  </nav>

  <PageHeader
    title="设计文档"
    subtitle={`查看 ${work.title} 的所有设计文档与技术记录`}
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {workDocs.length > 0 ? (
      <ul class="max-w-4xl divide-y divide-border border-t border-border">
        {workDocs.map((doc) => (
          <li>
            <DocumentCard doc={doc} docId={doc.docId} workSlug={slug} variant="row" />
          </li>
        ))}
      </ul>
    ) : (
      <div class="text-center py-20 text-text-secondary">暂无设计文档</div>
    )}
  </div>
</Layout>
