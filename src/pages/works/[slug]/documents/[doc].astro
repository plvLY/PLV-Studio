---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import ProjectToc from "../../../../components/ProjectToc.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { sortByLifecycle, docTypeLabel } from "../../../../lib/documents";

interface Props {
  entry: CollectionEntry<"documents">;
}

export async function getStaticPaths() {
  const entries = await getCollection("documents");
  return entries.map((entry) => {
    const [workSlug, docId] = entry.id.split("/");
    return { params: { slug: workSlug, doc: docId }, props: { entry } };
  });
}

const { entry } = Astro.props;
const [slug, docId] = entry.id.split("/");
const docEntry = { docId, ...entry.data };
const { Content, headings } = await render(entry);

const workEntries = await getCollection("works");
const workEntry = workEntries.find((work) => work.id === slug);
const work = workEntry ? { slug, ...workEntry.data } : undefined;

const docEntries = await getCollection("documents", ({ id }) => id.startsWith(`${slug}/`));
// 侧栏「同作品文档」、上一篇/下一篇与列表页使用同一排序（开发节点顺序）
const workDocs = sortByLifecycle(docEntries.map((d) => ({ docId: d.id.split("/")[1], ...d.data })));
const currentIndex = workDocs.findIndex((doc) => doc.docId === docId);
const previousDoc = currentIndex > 0 ? workDocs[currentIndex - 1] : undefined;
const nextDoc = currentIndex >= 0 && currentIndex < workDocs.length - 1 ? workDocs[currentIndex + 1] : undefined;

// 阅读长度来自真实 Markdown 正文，不写人工估计的「X 分钟」
const characterCount = (entry.body ?? "").replace(/\s+/g, "").length;
const visibleHeadingCount = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length;

const workHref = `/works/${slug}/`;
const documentsHref = `${workHref}documents/`;
const description = `${docEntry.summary}（${work?.title ?? "PLV Studio"} 设计文档）`;
---

<Layout
  title={docEntry.title}
  description={description}
  image={work?.cover || undefined}
  ogType="article"
>
  <div class="container-page pb-16 pt-6 sm:pt-8">
    <Breadcrumbs
      items={[
        { label: "首页", href: "/" },
        { label: "作品", href: "/works/" },
        { label: work?.title ?? "作品", href: workHref },
        { label: "设计文档", href: documentsHref },
        { label: docEntry.title },
      ]}
    />

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <article class="min-w-0 lg:col-span-8">
        <header class="border-b border-border pb-6">
          <p class="eyebrow">设计文档 · {docTypeLabel(docEntry.type)}</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
            {docEntry.title}
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary">{docEntry.summary}</p>

          <dl class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-text-secondary">
            <div class="flex items-center gap-1.5">
              <dt class="text-text-muted">版本</dt>
              <dd class="font-medium text-text-primary">{docEntry.version}</dd>
            </div>
            <div class="flex items-center gap-1.5">
              <dt class="text-text-muted">更新</dt>
              <dd><time datetime={docEntry.updatedAt} class="tabular-nums">{docEntry.updatedAt}</time></dd>
            </div>
            <div class="flex items-center gap-1.5">
              <dt class="text-text-muted">篇幅</dt>
              <dd class="tabular-nums">{characterCount.toLocaleString("zh-CN")} 字</dd>
            </div>
            <div class="flex items-center gap-1.5">
              <dt class="text-text-muted">章节</dt>
              <dd class="tabular-nums">{visibleHeadingCount} 节</dd>
            </div>
            <div class="flex items-center gap-1.5">
              <dt class="sr-only">所属作品</dt>
              <dd>
                <a href={workHref} class="text-link">{work?.title ?? "查看作品"} ↗</a>
              </dd>
            </div>
          </dl>
        </header>

        <!-- 移动端目录：原生 details，可键盘展开，不依赖脚本 -->
        <details class="surface-card mt-6 p-4 lg:hidden">
          <summary class="cursor-pointer text-sm font-semibold text-text-primary">本文目录</summary>
          <div class="mt-3">
            <ProjectToc headings={headings} id="toc-mobile" title="文档章节" />
          </div>
        </details>

        <div class="content-body mt-8">
          <Content />
        </div>

        <nav class="mt-12 border-t border-border pt-6" aria-label="文档翻页">
          <div class="grid gap-3 sm:grid-cols-2">
            {previousDoc ? (
              <a
                href={`${documentsHref}${previousDoc.docId}/`}
                class="surface-card group flex flex-col p-4 transition-colors hover:border-primary/40"
              >
                <span class="meta-label">上一篇</span>
                <span class="mt-1.5 text-sm font-semibold text-text-primary transition-colors group-hover:text-primary dark:group-hover:text-accent">
                  ← {previousDoc.title}
                </span>
                <span class="mt-1 text-xs text-text-muted">{docTypeLabel(previousDoc.type)} · {previousDoc.updatedAt}</span>
              </a>
            ) : (
              <span class="hidden sm:block" aria-hidden="true"></span>
            )}
            {nextDoc ? (
              <a
                href={`${documentsHref}${nextDoc.docId}/`}
                class="surface-card group flex flex-col p-4 text-right transition-colors hover:border-primary/40 sm:col-start-2"
              >
                <span class="meta-label">下一篇</span>
                <span class="mt-1.5 text-sm font-semibold text-text-primary transition-colors group-hover:text-primary dark:group-hover:text-accent">
                  {nextDoc.title} →
                </span>
                <span class="mt-1 text-xs text-text-muted">{docTypeLabel(nextDoc.type)} · {nextDoc.updatedAt}</span>
              </a>
            ) : null}
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <a href={documentsHref} class="text-link">全部设计文档</a>
            <a href={`${workHref}#progress`} class="text-link">查看开发进度</a>
          </div>
        </nav>
      </article>

      <!-- 侧栏：桌面目录 + 同作品文档 + 返回路径 -->
      <aside class="min-w-0 lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-24">
          <div class="surface-card hidden p-5 lg:block">
            <ProjectToc headings={headings} id="toc-desktop" />
          </div>

          <div class="surface-card p-5">
            <div class="flex items-center justify-between gap-3">
              <h2 class="meta-label">同作品文档</h2>
              <span class="text-xs tabular-nums text-text-muted">{workDocs.length} 份</span>
            </div>
            <ul class="mt-3 space-y-1">
              {workDocs.map((doc) => {
                const isCurrent = doc.docId === docId;
                return (
                  <li>
                    <a
                      href={`${documentsHref}${doc.docId}/`}
                      aria-current={isCurrent ? "page" : undefined}
                      class:list={[
                        "flex min-h-11 items-center justify-between gap-3 rounded-lg px-2.5 py-2 text-sm transition-colors",
                        isCurrent
                          ? "bg-primary/10 font-semibold text-primary dark:bg-accent/10 dark:text-accent"
                          : "text-text-secondary hover:bg-surface-muted hover:text-text-primary",
                      ]}
                    >
                      <span class="min-w-0">{doc.title}</span>
                      <span class="shrink-0 text-xs text-text-muted">{docTypeLabel(doc.type)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>

          <div class="surface-card p-5">
            <h2 class="meta-label">返回</h2>
            <div class="mt-3 space-y-2">
              <a href={workHref} class="btn btn-secondary w-full justify-start">
                ← {work?.title ?? "作品详情"}
              </a>
              <a href={documentsHref} class="btn btn-ghost w-full justify-start">
                设计文档列表
              </a>
            </div>
          </div>

          <p class="px-1 text-xs leading-relaxed text-text-muted">
            文档内容来自站内 Markdown 源文件；版本与日期由 frontmatter 提供，构建时校验格式。
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
