---
import Layout from "../../layouts/Layout.astro";
import WorkStatusBadge from "../../components/WorkStatusBadge.astro";
import TechStackTags from "../../components/TechStackTags.astro";
import DocumentCard from "../../components/DocumentCard.astro";
import ProgressTimeline from "../../components/ProgressTimeline.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { sortByLifecycle } from "../../lib/documents";
import { progress } from "../../data/progress";

interface Props {
  entry: CollectionEntry<"works">;
}

export async function getStaticPaths() {
  const entries = await getCollection("works", ({ data }) => data.published);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = entry.id;
const work = { slug, ...entry.data };
const { Content } = await render(entry);

// 同作品文档：entry.id 形如 plv-studio/requirements，取父目录匹配、子路径为 docId
// 展示顺序按开发节点（生命周期）排序，见 lib/documents.ts
const docEntries = await getCollection("documents", ({ id }) => id.startsWith(`${slug}/`));
const workDocs = sortByLifecycle(docEntries.map((d) => ({ docId: d.id.split("/")[1], ...d.data })));
const workProgress = progress[slug] ?? [];

// 外部入口：链接不存在时不显示空按钮（符合"真实可信"原则）
const externalLinks = [
  { url: work.demoUrl, label: "在线演示" },
  { url: work.sourceUrl, label: "源码仓库" },
  { url: work.videoUrl, label: "演示视频" },
].filter((l) => l.url);

const typeLabels: Record<string, string> = {
  "ai-application": "AI 应用",
  "developer-tool": "开发者工具",
  "data-visualization": "数据可视化",
  "tech-experiment": "技术实验",
};
---

<Layout title={work.title} description={work.summary}>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-6" aria-label="面包屑导航">
    <ol class="breadcrumbs flex items-center gap-2 text-sm text-text-secondary">
      <li><a href="/" class="hover:text-primary transition-colors">首页</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/works/" class="hover:text-primary transition-colors">作品</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-text-primary" aria-current="page">{work.title}</li>
    </ol>
  </nav>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- 项目概览 -->
    <header class="mb-10">
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl font-bold text-text-primary">
              {work.title}
            </h1>
            <WorkStatusBadge status={work.status} />
          </div>
          <p class="text-lg text-text-secondary">{work.summary}</p>
          <div class="flex flex-wrap gap-3 mt-4">
            <span class="text-sm text-text-secondary">类型：{typeLabels[work.type] ?? work.type}</span>
            <span class="text-sm text-text-secondary">开始时间：{work.startedAt}</span>
            <span class="text-sm text-text-secondary">最近更新：{work.updatedAt}</span>
          </div>
        </div>
        {work.cover ? (
          <img
            src={work.cover}
            alt={work.title + " 封面"}
            class="w-48 h-48 object-cover rounded-lg border border-border shrink-0"
            width="192"
            height="192"
          />
        ) : null}
      </div>

      <div class="bg-surface rounded-xl border border-border p-6">
        <h3 class="font-semibold text-text-primary mb-4">技术栈</h3>
        <TechStackTags tags={work.techStack} />
      </div>
    </header>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- 主内容区 -->
      <div class="lg:col-span-2 space-y-10">
        <!-- 项目介绍（渲染该作品自己的 content，而非全站共用文案） -->
        <section class="space-y-4">
          <h2 class="text-xl font-bold text-text-primary border-b border-border pb-2">
            项目介绍
          </h2>
          <div class="content-body text-left">
            <Content />
          </div>
        </section>

        <!-- 设计文档 -->
        <section class="space-y-4">
          <h2 class="text-xl font-bold text-text-primary border-b border-border pb-2">
            设计文档
          </h2>
          {workDocs.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {workDocs.map((doc) => (
                <DocumentCard doc={doc} docId={doc.docId} workSlug={work.slug} />
              ))}
            </div>
          ) : (
            <p class="text-text-secondary">暂无设计文档</p>
          )}
        </section>

        <!-- 开发进度 -->
        <ProgressTimeline entries={workProgress} />
      </div>

      <!-- 侧栏：项目元信息 -->
      <aside class="lg:col-span-1 space-y-6">
        <div class="bg-surface rounded-xl border border-border p-6 sticky top-24">
          <h3 class="font-semibold text-text-primary mb-4">项目信息</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between border-b border-border pb-2">
              <dt class="text-text-secondary">当前状态</dt>
              <dd><WorkStatusBadge status={work.status} /></dd>
            </div>
            <div class="flex justify-between border-b border-border pb-2">
              <dt class="text-text-secondary">作品类型</dt>
              <dd class="text-text-primary">{typeLabels[work.type] ?? work.type}</dd>
            </div>
            <div class="flex justify-between border-b border-border pb-2">
              <dt class="text-text-secondary">开始时间</dt>
              <dd class="text-text-primary">{work.startedAt}</dd>
            </div>
            <div class="flex justify-between border-b border-border pb-2">
              <dt class="text-text-secondary">最近更新</dt>
              <dd class="text-text-primary">{work.updatedAt}</dd>
            </div>
          </dl>
          {externalLinks.length > 0 && (
            <div class="mt-4">
              <h4 class="font-semibold text-text-primary mb-2">Demo、源码或视频入口</h4>
              <ul class="space-y-2">
                {externalLinks.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block text-sm text-primary hover:underline font-medium"
                    >
                      {link.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>
