---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import WorkCard from "../components/WorkCard.astro";
import { getCollection } from "astro:content";

const publishedWorks = (await getCollection("works", ({ data }) => data.published)).map((e) => ({
  slug: e.id,
  ...e.data,
}));
---

<Layout title="作品集" description="统一浏览所有公开作品 - PLV Studio">
  <PageHeader
    title="我的作品"
    subtitle={`精选项目、设计文档、开发进度与技术实现。共 ${publishedWorks.length} 个公开作品`}
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {publishedWorks.length > 0 ? (
        publishedWorks.map((work) => (
          <WorkCard work={work} />
        ))
      ) : (
        <div class="col-span-full text-center py-20 text-text-secondary">
          暂无公开作品
        </div>
      )}
    </div>
  </div>
</Layout>
