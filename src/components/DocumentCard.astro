---
import type { CollectionEntry } from "astro:content";
import { docTypeLabel } from "../lib/documents";

interface Props {
  /** documents 集合条目的 frontmatter（title/type/version/updatedAt/summary） */
  doc: CollectionEntry<"documents">["data"];
  /** 文档 id（文件名，位于作品目录下），如 requirements */
  docId: string;
  workSlug: string;
  /** card=卡片（默认）；row=列表行（文档列表页使用，降低卡片化程度） */
  variant?: "card" | "row";
}
const { doc, docId, workSlug, variant = "card" } = Astro.props;
// 链接由 slug + docId 推导并统一使用尾斜杠（与 trailingSlash: 'always' 对齐）
const href = `/works/${workSlug}/documents/${docId}/`;
---

{variant === "row" ? (
  <a
    href={href}
    class="document-card group -mx-3 flex min-h-16 flex-wrap items-center gap-x-4 gap-y-2 rounded-lg px-3 py-4 transition-colors hover:bg-surface-muted/60"
  >
    <h2 class="min-w-0 text-base font-semibold text-text-primary transition-colors group-hover:text-primary dark:group-hover:text-accent">
      {doc.title}
    </h2>
    <span class="shrink-0 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-accent">
      {docTypeLabel(doc.type)}
    </span>
    <span class="w-full text-xs text-text-secondary sm:ml-auto sm:w-auto sm:shrink-0">
      版本 {doc.version} · 更新 <time datetime={doc.updatedAt}>{doc.updatedAt}</time>
    </span>
    <span class="hidden text-sm text-text-muted transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transform-none sm:inline" aria-hidden="true">
      →
    </span>
  </a>
) : (
  <article class="document-card flex h-full flex-col rounded-xl border border-border bg-surface p-4 transition-colors hover:border-primary/40">
    <div class="flex items-start justify-between gap-2">
      <h3 class="min-w-0 text-base font-semibold text-text-primary">
        <a href={href} class="underline-offset-4 hover:text-primary hover:underline dark:hover:text-accent">
          {doc.title}
        </a>
      </h3>
      <span class="shrink-0 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary dark:text-accent">
        {docTypeLabel(doc.type)}
      </span>
    </div>
    <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-text-secondary">{doc.summary}</p>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-border/70 pt-3 text-xs text-text-secondary">
      <span>版本 {doc.version} · 更新 <time datetime={doc.updatedAt}>{doc.updatedAt}</time></span>
      <a href={href} class="font-medium text-primary underline-offset-4 hover:underline dark:text-accent">
        阅读文档 →
      </a>
    </div>
  </article>
)}
