---
interface Props {
  /** 初始是否为暗色（服务端无法得知，由 Layout 的内联脚本在首帧前设置 .dark 类，图标经 dark: 变体自动切换） */
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<button
  id="theme-toggle"
  class="theme-toggle inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2.5 text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
  type="button"
  aria-label={dark ? "切换到浅色模式" : "切换到暗色模式"}
  aria-pressed={dark}
  title={dark ? "切换到浅色模式" : "切换到暗色模式"}
>
  <svg
    class="sun-icon hidden h-5 w-5 dark:block"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  <svg
    class="moon-icon block h-5 w-5 dark:hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script>
  // 与 Layout.astro 的内联预置脚本保持同一套判定逻辑
  function syncThemeButton() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const isDark = document.documentElement.classList.contains("dark");
    const label = isDark ? "切换到浅色模式" : "切换到暗色模式";
    btn.setAttribute("aria-pressed", String(isDark));
    btn.setAttribute("aria-label", label);
    btn.setAttribute("title", label);
  }

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    localStorage.setItem("theme", dark ? "dark" : "light");
    syncThemeButton();
  }

  // ClientRouter 页面交换后脚本不会自动重执行，挂到 astro:page-load（首载也会触发）
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("theme-toggle");
    // 首帧可能已通过内联脚本进入暗色，需要同步 aria-pressed 与可访问名称
    syncThemeButton();
    btn?.addEventListener("click", () => {
      applyTheme(!document.documentElement.classList.contains("dark"));
    });
  });
</script>

<style>
  .theme-toggle {
    cursor: pointer;
  }
</style>
