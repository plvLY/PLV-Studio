---
interface Props {
  title: string;
  subtitle?: string;
  /** 小型眉题，用于补充页面在站点中的位置 */
  eyebrow?: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<header class="container-page pb-8 pt-10 sm:pb-10 lg:pt-14">
  <div class="max-w-3xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class:list={["text-3xl font-bold tracking-tight text-text-primary sm:text-4xl", eyebrow && "mt-2"]}>
      {title}
    </h1>
    {subtitle && (
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">{subtitle}</p>
    )}
    <slot />
  </div>
</header>
