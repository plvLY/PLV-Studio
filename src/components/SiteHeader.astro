---
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const navItems = [
  { href: "/", label: "首页" },
  { href: "/works/", label: "作品" },
  { href: "/about/", label: "关于" },
];
const linkBase =
  "inline-flex min-h-11 items-center rounded-md px-3 text-sm font-medium transition-colors";
const linkActive = "bg-primary/10 font-semibold text-primary dark:bg-accent/10 dark:text-accent";
const linkIdle = "text-text-secondary hover:bg-surface-muted hover:text-text-primary";
---

<header class="site-header sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-3 sm:h-[4.5rem]">
      <a
        href="/"
        class="flex min-w-0 items-center gap-2.5 font-bold text-lg text-primary dark:text-accent sm:text-xl"
        aria-label="PLV Studio 首页"
      >
        <img
          src="/logo.png"
          alt=""
          class="h-8 w-8 shrink-0 rounded-full"
          width="250"
          height="250"
        />
        <span class="truncate">PLV Studio</span>
      </a>

      <!-- 桌面导航：常驻入口保持克制，外链与站内导航用分隔线区分 -->
      <nav class="hidden items-center gap-0.5 md:flex" aria-label="主导航">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`${linkBase} ${isActive(item.href) ? linkActive : linkIdle}`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
        <span class="mx-2 h-4 w-px bg-border" aria-hidden="true"></span>
        <a
          href="https://plv.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class={`${linkBase} ${linkIdle} gap-1`}
        >
          博客
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
          <span class="sr-only">（在新标签页打开）</span>
        </a>
      </nav>

      <div class="flex shrink-0 items-center gap-1">
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary md:hidden"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="打开导航菜单"
        >
          <svg class="menu-icon-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="menu-icon-close hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 移动端导航：展开时作为顶栏下方的面板，不重复桌面常驻布局 -->
    <nav id="mobile-menu" class="hidden pb-4 md:hidden" aria-label="移动端导航">
      <div class="grid gap-1 rounded-xl border border-border bg-surface p-2 shadow-sm">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`flex min-h-11 items-center justify-between rounded-lg px-3 py-2.5 text-sm transition-colors ${
              isActive(item.href)
                ? "bg-primary/10 font-semibold text-primary dark:bg-accent/10 dark:text-accent"
                : "text-text-secondary hover:bg-surface-muted hover:text-text-primary"
            }`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
            {isActive(item.href) && <span class="text-xs" aria-hidden="true">当前</span>}
          </a>
        ))}
        <a
          href="https://plv.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-11 items-center justify-between rounded-lg px-3 py-2.5 text-sm text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
        >
          <span>博客</span>
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
            <span class="sr-only">（在新标签页打开）</span>
          </span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // ClientRouter 页面交换后脚本不会自动重执行，统一挂到 astro:page-load（首载也会触发）
  function setMenuOpen(open: boolean) {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
    btn?.querySelector(".menu-icon-open")?.classList.toggle("hidden", open);
    btn?.querySelector(".menu-icon-close")?.classList.toggle("hidden", !open);
  }

  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    // 新页面初始态始终为收起，避免路由器交换后保留上一页的展开状态
    setMenuOpen(false);

    btn?.addEventListener("click", () => {
      setMenuOpen(menu?.classList.contains("hidden") ?? false);
    });

    // 点击任意菜单项后自动收起
    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });
  });

  // Esc 键关闭移动菜单并把焦点交还给按钮（document 级只挂一次）
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const menu = document.getElementById("mobile-menu");
      if (menu && !menu.classList.contains("hidden")) {
        setMenuOpen(false);
        document.getElementById("mobile-menu-btn")?.focus();
      }
    }
  });
</script>
