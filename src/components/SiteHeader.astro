---
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const navItems = [
  { href: "/", label: "首页" },
  { href: "/works/", label: "作品" },
  { href: "/about/", label: "关于" },
];
const linkBase =
  "nav-link px-3 py-2 rounded-md transition-colors";
const linkActive = "text-primary dark:text-accent font-semibold bg-primary/10 dark:bg-accent/10";
const linkIdle = "text-secondary hover:text-primary dark:hover:text-accent";
---

<header class="site-header sticky top-0 z-50 bg-background/95 backdrop-blur-sm border-b border-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-between gap-4 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-bold text-xl text-primary dark:text-accent"
      >
        <img src="/logo.png" alt="PLV Studio" class="h-8 w-auto" />
        <span>PLV Studio</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium" aria-label="主导航">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`${linkBase} ${isActive(item.href) ? linkActive : linkIdle}`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
        <a
          href="https://plv.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class={`${linkBase} ${linkIdle}`}
        >
          博客
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile nav -->
    <div class="md:hidden border-t border-border">
      <button
        id="mobile-menu-btn"
        class="w-full flex items-center justify-between px-4 py-4 text-secondary hover:text-primary"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="font-medium">菜单</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <nav
        id="mobile-menu"
        class="hidden bg-surface border-t border-border py-4"
        aria-label="移动端导航"
      >
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-2 transition-colors ${isActive(item.href) ? "text-primary dark:text-accent font-semibold bg-surface-muted" : "text-secondary hover:text-primary hover:bg-surface-muted"}`}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
        <a href="https://plv.netlify.app/" target="_blank" rel="noopener noreferrer" class="block px-4 py-2 text-secondary hover:text-primary hover:bg-surface-muted transition-colors">
          博客
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  function setMenuOpen(open: boolean) {
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
  }

  btn?.addEventListener("click", () => {
    setMenuOpen(menu?.classList.contains("hidden") ?? false);
  });

  // 点击任意菜单项后自动收起
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
</script>
