---
interface Props {
  /** 页脚一句话描述（由 Layout 传入页面 description） */
  description?: string;
}
const { description = "记录个人作品、设计文档、开发进度与技术实践。" } = Astro.props;
---

<footer class="site-footer mt-auto border-t border-border bg-surface">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div>
        <div class="font-bold text-lg text-primary dark:text-accent">PLV Studio</div>
        <div class="text-sm text-secondary mt-1">{description}</div>
      </div>
      <nav class="flex gap-6 text-sm text-secondary" aria-label="页脚导航">
        <a href="/" class="hover:text-primary transition-colors">首页</a>
        <a href="/works/" class="hover:text-primary transition-colors">作品</a>
        <a href="/about/" class="hover:text-primary transition-colors">关于</a>
        <a
          href="https://plv.netlify.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors"
        >
          博客
        </a>
      </nav>
    </div>
    <div class="mt-8 md:mt-0 border-t border-border pt-6 text-xs text-secondary text-center">
      PLV Studio · 基于 Astro 与 Tailwind CSS 构建 · 通过 Netlify 部署
    </div>
  </div>
</footer>
