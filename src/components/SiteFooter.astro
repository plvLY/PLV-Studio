---
// 方案 2：页脚移除站内导航（与 sticky 顶部导航重复），只保留品牌 ｜ 联系 ｜ 版权
// 站内跳转由常驻顶栏承担（全站任意位置一次点击可达），页脚专职品牌收尾与联系方式
const tagline = "记录个人作品、设计文档、开发进度与技术实践。";

const contactLinks = [
  { href: "https://github.com/plvLY", label: "GitHub", icon: "github", external: true },
  { href: "https://gitee.com/plv-coding", label: "Gitee", icon: "gitee", external: true },
  { href: "mailto:837965182@qq.com", label: "837965182@qq.com", icon: "mail", external: false },
];

// 描边风格图标（2px stroke），与站内 clock/menu 图标同一套
const icons: Record<string, string> = {
  github:
    "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
  gitee:
    "M12 3c-1.1 0-2 .9-2 2v2H5.5A1.5 1.5 0 0 0 4 8.5v10A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-10A1.5 1.5 0 0 0 18.5 7H14V5c0-1.1-.9-2-2-2z",
  mail: "M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm0 1.5l8 5.5 8-5.5",
};

const linkClass =
  "group inline-flex items-center gap-1.5 min-h-11 px-1 text-sm text-text-secondary hover:text-primary dark:hover:text-accent transition-colors duration-150";
---

<footer class="site-footer mt-auto border-t border-border bg-surface">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- 单行：品牌 ｜ 联系（窄屏纵向堆叠、组内仍保持横排） -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-x-8 gap-y-1">
      <!-- 品牌：名称与定位语同一行 -->
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 min-w-0">
        <span class="font-bold text-primary dark:text-accent">PLV Studio</span>
        <span class="text-xs text-text-secondary">{tagline}</span>
      </div>

      <!-- 联系：仓库主页与邮箱，图标 + 短标签横排 -->
      <div class="flex flex-wrap items-center gap-x-5" role="group" aria-label="联系方式">
        {contactLinks.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class={linkClass}
          >
            <svg
              class="w-4 h-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[item.icon]} />
            </svg>
            {item.label}
            {item.external && <span aria-hidden="true" class="text-xs">↗</span>}
          </a>
        ))}
      </div>
    </div>

    <!-- 底行：固定版权与技术说明 -->
    <div class="mt-3 border-t border-border pt-3 text-xs text-text-secondary text-center">
      © 2026 PLV Studio · 基于 Astro 与 Tailwind CSS 构建 · 通过 Netlify 部署
    </div>
  </div>
</footer>
