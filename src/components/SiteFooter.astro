---
// 页脚三组：品牌 / 站内导航 / 外部链接
// 站内导航只保留「作品、文档、关于」三个补充入口，不重复顶部导航的完整结构。
const siteLinks = [
  { href: "/works/", label: "作品档案" },
  { href: "/works/plv-studio/documents/", label: "设计文档" },
  { href: "/about/", label: "关于与工作方式" },
];

const externalLinks = [
  { href: "https://github.com/plvLY", label: "GitHub", icon: "github" },
  { href: "https://gitee.com/plv-coding", label: "Gitee", icon: "gitee" },
  {
    href: "mailto:837965182@qq.com",
    label: "837965182@qq.com",
    icon: "mail",
  },
];

const icons: Record<string, string> = {
  github:
    "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
  gitee:
    "M12 3c-1.1 0-2 .9-2 2v2H5.5A1.5 1.5 0 0 0 4 8.5v10A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-10A1.5 1.5 0 0 0 18.5 7H14V5c0-1.1-.9-2-2-2z",
  mail: "M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm0 1.5l8 5.5 8-5.5",
};

const linkClass =
  "group inline-flex min-h-11 items-center gap-2 rounded-md text-sm text-text-secondary transition-colors hover:text-primary dark:hover:text-accent";
---

<footer class="mt-auto border-t border-border bg-surface">
  <div class="container-page">
    <div class="grid gap-x-8 gap-y-9 py-10 md:grid-cols-12 md:py-12">
      <!-- 品牌区 -->
      <div class="md:col-span-5">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-bold text-lg text-primary dark:text-accent"
          aria-label="PLV Studio 首页"
        >
          <img src="/logo.png" alt="" class="h-7 w-7 rounded-full" width="250" height="250" />
          <span>PLV Studio</span>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-text-secondary">
          记录真实项目从需求分析、产品设计、技术架构到开发验收的过程，以及每个阶段可追溯的文档与技术产物。
        </p>
        <p class="mt-3 text-xs text-text-muted">个人作品与技术实践</p>
      </div>

      <!-- 站内导航 -->
      <nav class="md:col-span-3" aria-labelledby="footer-nav-title">
        <h2 id="footer-nav-title" class="meta-label">站内</h2>
        <ul class="mt-2 space-y-0.5">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- 外部链接：GitHub / Gitee / QQ 邮箱 -->
      <div class="md:col-span-4">
        <h2 class="meta-label">外部链接</h2>
        <ul class="mt-2 space-y-0.5">
          {externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class={linkClass}
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[link.icon]} />
                </svg>
                <span class="break-all">{link.label}</span>
                {link.href.startsWith("http") && (
                  <>
                    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                    <span class="sr-only">（在新标签页打开）</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 底行：版权与技术说明 -->
    <div class="flex flex-col gap-2 border-t border-border py-5 text-xs text-text-secondary sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 PLV Studio · 保留所有权利</p>
      <p>基于 Astro 与 Tailwind CSS 构建 · 通过 Netlify 部署</p>
    </div>
  </div>
</footer>
