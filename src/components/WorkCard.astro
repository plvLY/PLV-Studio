---
import type { CollectionEntry } from "astro:content";
import WorkStatusBadge from "./WorkStatusBadge.astro";
import TechStackTags from "./TechStackTags.astro";
import { coverAlt, publicStatusLabel, workTypeLabel } from "../lib/works";

interface Props {
  /** works 集合条目映射为 { slug, ...frontmatter } 后的形状 */
  work: { slug: string } & CollectionEntry<"works">["data"];
  variant?: "default" | "featured";
  /** 卡片排布：vertical=封面在上（默认）；horizontal=封面在左、文字在右（少量作品时压低视觉占比） */
  layout?: "vertical" | "horizontal";
}
const { work, variant = "default", layout = "vertical" } = Astro.props;
const isFeatured = variant === "featured";
const isHorizontal = layout === "horizontal";
const detailHref = `/works/${work.slug}/`;
const statusText = publicStatusLabel(work.status, work.demoUrl);
---

<article
  class:list={[
    "work-card group overflow-hidden rounded-xl border border-border bg-surface transition-colors",
    "hover:border-primary/40",
    isFeatured && "md:col-span-2 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-stretch",
    isHorizontal && "sm:grid sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:items-center",
  ]}
>
  <!-- 截图区：16:9 统一封面比例；featured/horizontal 转为左半栏（保持 16:9 不拉伸） -->
  <div class:list={["p-2.5", (isFeatured || isHorizontal) && "sm:h-full"]}>
    <div class:list={["relative", (isFeatured || isHorizontal) && "sm:h-full"]}>
      {work.cover ? (
        <a
          href={detailHref}
          class="block overflow-hidden rounded-lg focus-visible:outline-offset-4"
          aria-label={`查看 ${work.title} 项目详情`}
        >
          <img
            src={work.cover}
            alt={coverAlt(work.title, work.coverKind)}
            class:list={[
              "aspect-video w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.01] motion-reduce:transform-none",
              isFeatured && "md:h-full",
            ]}
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div class="flex aspect-video w-full items-center justify-center rounded-lg bg-surface-muted text-sm text-text-secondary">
          暂无项目截图
        </div>
      )}
      <div class="pointer-events-none absolute right-2.5 top-2.5">
        <WorkStatusBadge status={work.status} variant="overlay" label={statusText} />
      </div>
    </div>
  </div>

  <!-- 内容区：类型/标题 → 描述 → 技术标签 → 页脚（日期 + 详情入口） -->
  <div
    class:list={[
      "flex flex-1 flex-col px-5 pb-5 pt-2",
      isFeatured && "md:justify-center md:p-6",
      isHorizontal && "sm:justify-center sm:p-6",
    ]}
  >
    <div class="flex items-center gap-2.5">
      {work.icon ? (
        <img
          src={work.icon}
          alt=""
          class="h-8 w-8 shrink-0 rounded-lg object-cover"
          width="32"
          height="32"
        />
      ) : (
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface-muted text-sm font-semibold text-text-secondary">
          {work.title.slice(0, 1)}
        </span>
      )}
      <div class="min-w-0">
        <p class="text-xs text-text-muted">{workTypeLabel(work.type)}</p>
        <h3 class="truncate text-lg font-semibold text-text-primary">
          <a href={detailHref} class="underline-offset-4 hover:underline">{work.title}</a>
        </h3>
      </div>
    </div>

    <p class="mt-3 line-clamp-2 flex-1 text-sm leading-relaxed text-text-secondary sm:line-clamp-3">
      {work.summary}
    </p>

    <div class="mt-4">
      <TechStackTags tags={work.techStack.slice(0, 4)} />
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-border/70 pt-3 text-xs text-text-secondary">
      <span class="inline-flex items-center gap-1.5">
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        最近更新 <time datetime={work.updatedAt}>{work.updatedAt}</time>
      </span>
      <a href={detailHref} class="font-medium text-primary underline-offset-4 hover:underline dark:text-accent">
        查看详情 →
      </a>
    </div>
  </div>
</article>
