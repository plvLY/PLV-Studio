---
import type { ProgressStatus } from "../types";
import { releaseState } from "../lib/progress";

interface Props {
  status: ProgressStatus;
  /** 覆盖文案（默认按状态取 Released / In Progress / Planned…） */
  label?: string;
  size?: "sm" | "md";
}

const { status, label, size = "sm" } = Astro.props;
const state = releaseState(status);

// 状态不能只靠颜色：徽标始终带文字（英文标签 + 中文 aria-label）。
const toneClass: Record<string, string> = {
  released: "border-success/35 bg-success/10 text-success",
  trial: "border-cyan-500/35 bg-cyan-500/10 text-cyan-700 dark:text-cyan-300",
  progress: "border-warning/35 bg-warning/10 text-warning",
  planned: "border-border bg-surface-muted text-text-muted",
  blocked: "border-red-500/35 bg-red-500/10 text-red-700 dark:text-red-300",
  archived: "border-border bg-surface-muted text-text-muted",
};

const dotClass: Record<string, string> = {
  released: "bg-success",
  trial: "bg-cyan-500",
  progress: "bg-warning",
  planned: "bg-text-muted",
  blocked: "bg-red-500",
  archived: "bg-text-muted",
};

const padding = size === "md" ? "px-2.5 py-1 text-[11px]" : "px-2 py-0.5 text-[10px]";
const text = label ?? state.english;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border font-mono font-semibold uppercase tracking-[0.08em]",
    toneClass[state.tone],
    padding,
  ]}
  title={`${state.label}（${state.english}）`}
  aria-label={`${state.label}（${state.english}）`}
>
  <span class:list={["h-1.5 w-1.5 shrink-0 rounded-full", dotClass[state.tone]]} aria-hidden="true"></span>
  <span aria-hidden="true">[{text}]</span>
</span>
