---
interface RouteItem {
  icon: "recruiter" | "engineer";
  eyebrow: string;
  title: string;
  description: string;
  meta: string[];
  href: string;
  action: string;
}

interface Props {
  routes: RouteItem[];
  id?: string;
}

const { routes, id = "route" } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={titleId} class="border-b border-border bg-surface-muted/40">
  <div class="container-page py-7 sm:py-9">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <div class="flex items-baseline gap-3">
        <h2 id={titleId} class="text-sm font-semibold text-text-primary">按身份快速进入</h2>
        <span class="hidden text-xs text-text-muted sm:inline">招聘方看结果，技术同行看实现</span>
      </div>
      <p class="text-xs text-text-muted">不想选择？直接往下浏览也可以</p>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {routes.map((route) => (
        <a
          href={route.href}
          class="group flex min-h-20 flex-wrap items-start gap-3.5 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-primary/40 hover:bg-surface sm:flex-nowrap sm:items-center sm:p-5"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
            {route.icon === "recruiter" ? (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            ) : (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m4 17 6-6-6-6"></path>
                <path d="M12 19h8"></path>
              </svg>
            )}
          </span>

          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
              <span class="font-semibold text-text-primary transition-colors group-hover:text-primary dark:group-hover:text-accent">
                {route.title}
              </span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-text-muted">{route.eyebrow}</span>
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-text-secondary">{route.description}</span>
            <span class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
              {route.meta.map((item) => (
                <span>{item}</span>
              ))}
            </span>
          </span>

          <span class="order-last flex w-full items-center gap-1 pl-[3.4rem] text-xs font-medium text-primary dark:text-accent sm:order-none sm:w-auto sm:shrink-0 sm:self-center sm:pl-0">
            {route.action}
            <span class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transform-none" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
